use anyhow::{Result, bail};
use serde_json::Value;
use std::collections::BTreeMap;
use vrl::{compiler::{compile, CompileConfig, TargetValueRules}, value, Program, state::RuntimeState, value::Value as VrlValue, TimeZone};
use crate::router::Vendor;

pub struct VrlEngine {
    fortinet_program: Program,
    cisco_program: Program,
    palo_program: Program,
}

impl VrlEngine {
    pub fn new() -> Result<Self> {
        let fortinet_script = r#"
            .src_ip = parse_regex!(string!(.), r"srcip=(?P<ip>\d+\.\d+\.\d+\.\d+)").ip ?? "0.0.0.0"
        "#;
        let cisco_script = r#"
            .src_ip = parse_regex!(string!(.), r"outside:(?P<ip>\d+\.\d+\.\d+\.\d+)").ip ?? "0.0.0.0"
        "#;
        let palo_script = r#"
            .src_ip = parse_regex!(string!(.), r",(?P<ip>\d+\.\d+\.\d+\.\d+),").ip ?? "0.0.0.0"
        "#;

        let fortinet_program = compile(fortinet_script, &vrl::compiler::VrlExtension::default()).map_err(|_| anyhow::anyhow!("Fortinet VRL compile error"))?.program;
        let cisco_program = compile(cisco_script, &vrl::compiler::VrlExtension::default()).map_err(|_| anyhow::anyhow!("Cisco VRL compile error"))?.program;
        let palo_program = compile(palo_script, &vrl::compiler::VrlExtension::default()).map_err(|_| anyhow::anyhow!("Palo VRL compile error"))?.program;
        
        Ok(Self {
            fortinet_program,
            cisco_program,
            palo_program,
        })
    }

    pub fn process(&self, vendor: &Vendor, raw_log: &str) -> Result<Value> {
        let mut map = serde_json::Map::new();
        map.insert("message".into(), Value::String(raw_log.to_string()));
        
        match vendor {
            Vendor::Fortinet | Vendor::CiscoAsa | Vendor::PaloAlto => {},
            Vendor::Unknown => bail!("Unknown vendor, cannot parse"),
        };
        
        Ok(Value::Object(map))
    }
}
